local HitboxIndicators = {}; setmetatable(HitboxIndicators, { __mode = "k" })
local function updateHitboxIndicator(part, size, color)
    local indicator = part:FindFirstChild("HB_SizeIndicator")
    if not indicator then
        indicator = Instance.new("Part"); indicator.Name = "HB_SizeIndicator"; indicator.Size = size; indicator.CFrame = part.CFrame; indicator.Transparency = 0.5; indicator.Color = color; indicator.Material = Enum.Material.ForceField; indicator.CanCollide = false; indicator.CanQuery = false; indicator.Massless = true; indicator.Anchored = false
        local weld = Instance.new("WeldConstraint"); weld.Part0 = part; weld.Part1 = indicator; weld.Parent = indicator; indicator.Parent = part
        HitboxIndicators[part] = indicator
    else indicator.Size = size; indicator.Color = color end
end
local function removeHitboxIndicator(part) local i = part:FindFirstChild("HB_SizeIndicator"); if i then i:Destroy() end; HitboxIndicators[part] = nil end
local function resetSinglePart(part)
    if not part or not part.Parent then return end
    local orig = OriginalPartSizes[part]
    if orig then pcall(function() part.Size = orig.Size; part.CanCollide = orig.CanCollide; part.Massless = orig.Massless; part.Transparency = orig.Transparency; if sethiddenproperty then pcall(function() sethiddenproperty(part, "CanQuery", true) end) end end) end
    removeHitboxIndicator(part)
end

RefreshHitboxes = function()
    for _, player in ipairs(Players:GetPlayers()) do
        if player == lp then continue end
        local char = player.Character; if not char then continue end
        local targetPart = char:FindFirstChild("Head")
        if not Settings.Hitbox.enabled or (Settings.Hitbox.teamCheck and IsTeammate(player)) then
            if targetPart then resetSinglePart(targetPart) end; continue
        end
        if not targetPart or not targetPart:IsA("BasePart") then continue end
        saveOriginalData(targetPart)
        local dSize = Vector3.new(Settings.Hitbox.x, Settings.Hitbox.y, Settings.Hitbox.z)
        if targetPart.Size ~= dSize then targetPart.Size = dSize; targetPart.CanCollide = false; targetPart.Massless = true; targetPart.Transparency = 1; targetPart.CollisionGroup = "Default"; if sethiddenproperty then pcall(function() sethiddenproperty(targetPart, "CanQuery", true) end) end end
        if Settings.Hitbox.show then updateHitboxIndicator(targetPart, dSize, Settings.Hitbox.color) else removeHitboxIndicator(targetPart) end
