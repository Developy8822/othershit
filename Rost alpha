local function xorDecrypt(base64text, key)
    local b = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    local lookup = {}
    for i = 1, #b do lookup[string.byte(b, i)] = i - 1 end
    local keyStr = tostring(key)
    local keyLen = #keyStr
    local out = {}
    local outIdx = 0
    local buffer = 0
    local bits = 0
    for i = 1, #base64text do
        local val = lookup[string.byte(base64text, i)]
        if val then
            buffer = bit32.bor(bit32.lshift(buffer, 6), val)
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                local charByte = bit32.band(bit32.rshift(buffer, bits), 0xFF)
                local keyByte = string.byte(keyStr, (outIdx % keyLen) + 1)
                outIdx = outIdx + 1
                out[outIdx] = string.char(bit32.bxor(charByte, keyByte))
            end
        end
    end
    return table.concat(out)
end

