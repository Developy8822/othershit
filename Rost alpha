local function getPartCorners(part)
    if part.Name == "HB_SizeIndicator" then return {} end
    saveOriginalData(part)
    local cf, size = part.CFrame, part.Size
    if OriginalPartSizes[part] then size = OriginalPartSizes[part].Size end
    if size.X > 4 or size.Y > 4 or size.Z > 4 then size = Vector3.new(1.2, 1.2, 1.2) end
    local sx, sy, sz = size.X / 2, size.Y / 2, size.Z / 2
    return { cf * Vector3.new(sx, sy, sz), cf * Vector3.new(sx, sy, -sz), cf * Vector3.new(sx, -sy, sz), cf * Vector3.new(sx, -sy, -sz), cf * Vector3.new(-sx, sy, sz), cf * Vector3.new(-sx, sy, -sz), cf * Vector3.new(-sx, -sy, sz), cf * Vector3.new(-sx, -sy, -sz) }
end

