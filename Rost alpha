RunService.RenderStepped:Connect(function()
    if Settings.Visuals.timeChanger then Lighting.ClockTime = Settings.Visuals.timeValue end
    Camera.FieldOfView = Settings.Misc.zoom and 30 or 70

    local closestDist = Settings.Combat.showFov and Settings.Combat.fovRadius or math.huge
    currentTarget, currentTargetPart = nil, nil
    local mouseLoc = UIS:GetMouseLocation()
    
    if Settings.Combat.silentAim then
        for _, player in ipairs(Players:GetPlayers()) do
            if player ~= lp and player.Character and player.Character:FindFirstChild(Settings.Combat.targetPart) then
                local hum = player.Character:FindFirstChild("Humanoid")
                if hum and hum.Health > 0 and not IsTeammate(player) then
                    local part = player.Character[Settings.Combat.targetPart]
                    local pos, onScreen = Camera:WorldToViewportPoint(part.Position)
                    if onScreen then
                        local dist = (Vector2.new(pos.X, pos.Y) - mouseLoc).Magnitude
                        if dist < closestDist then closestDist = dist; currentTargetPart = part; currentTarget = player end
                    end
                end
            end
        end
    end

    FOVCircle.Visible = Settings.Combat.showFov
    if FOVCircle.Visible then FOVCircle.Position = mouseLoc; FOVCircle.Radius = Settings.Combat.fovRadius; FOVCircle.Color = Settings.Combat.fovColor end

    TracerLine.Visible = Settings.Combat.targetLine and currentTargetPart ~= nil
    if TracerLine.Visible then
        local pos, onScreen = Camera:WorldToViewportPoint(currentTargetPart.Position)
        if onScreen then TracerLine.From = mouseLoc; TracerLine.To = Vector2.new(pos.X, pos.Y); TracerLine.Color = Settings.Combat.targetLineColor else TracerLine.Visible = false end
    end

    local screenSize = Camera.ViewportSize
    local yPos = (screenSize.Y / 2) + 40

    SATitle.Visible = Settings.Combat.showInfo
    if Settings.Combat.showInfo then SATitle.Position = UDim2.fromOffset(screenSize.X / 2, yPos); yPos = yPos + 25 end

    SATarget.Visible = Settings.Combat.showInfo and currentTarget ~= nil
    if SATarget.Visible then SATarget.Position = UDim2.fromOffset(screenSize.X / 2, yPos); SATarget.Text = currentTarget.Name; yPos = yPos + 20 end

    SAStatus.Visible = Settings.Combat.showInfo and currentTarget ~= nil
    if SAStatus.Visible then
        SAStatus.Position = UDim2.fromOffset(screenSize.X / 2, yPos)
        if isWeaponEquipped and currentTarget.Character and currentTarget.Character:FindFirstChild("HumanoidRootPart") and lp.Character and lp.Character:FindFirstChild("HumanoidRootPart") then
            local dist3D = (currentTarget.Character.HumanoidRootPart.Position - lp.Character.HumanoidRootPart.Position).Magnitude
            if dist3D > currentWeaponRange then SAStatus.Text = "Out of range"; SAStatus.TextColor3 = Color3.fromRGB(255, 50, 50) else SAStatus.Text = "Shoot!"; SAStatus.TextColor3 = Color3.fromRGB(50, 255, 50) end
        else
            SAStatus.Text = "No weapon"; SAStatus.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
    end

    InvContainer.Visible = Settings.Combat.targetInv and currentTarget ~= nil
    if InvContainer.Visible then
        local targetTools = {}
        if currentTarget.Character then
            for _, item in pairs(currentTarget.Character:GetChildren()) do
                if item:IsA("Tool") then table.insert(targetTools, item) end
            end
        end
        if currentTarget:FindFirstChild("Backpack") then
            for _, item in pairs(currentTarget.Backpack:GetChildren()) do
                if item:IsA("Tool") then table.insert(targetTools, item) end
            end
        end

        for i = 1, 6 do
            local slotData = invSlots[i]
            local tool = targetTools[i]
            
            if tool and tool.TextureId ~= "" then slotData.Image.Image = tool.TextureId else slotData.Image.Image = "" end

            local success, err = pcall(function()
                local hotbarGui = lp.PlayerGui:FindFirstChild("Hotbar")
                if hotbarGui then
                    local slotFrame = hotbarGui:FindFirstChild("SlotFrame")
                    if slotFrame then
                        local targetSlot = slotFrame:FindFirstChild("Slot" .. i)
                        if targetSlot then
                            local numberLabel = targetSlot:FindFirstChild("NumberLabel")
                            if numberLabel then slotData.Amount.Text = numberLabel.Text; return end
                        end
                    end
                end
                slotData.Amount.Text = "0"
            end)
            if not success then slotData.Amount.Text = "0" end
        end
    end
end)

