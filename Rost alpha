local recentDmg, lastHit, deathSeen = setmetatable({}, {__mode="k"}), {}, setmetatable({}, {__mode="k"})
local function onDamaged(plr, char, dmg, hp)
    if dmg <= 0.01 or plr == lp then return end
    local now = os.clock(); local rp = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Head")
    if not (rp and isOurs(rp.Position)) then return end
    local prev = recentDmg[plr]
    if prev and now - prev.t <= 0.2 and math.abs(prev.h - hp) <= 0.001 and math.abs(prev.d - dmg) <= 0.001 then return end
    recentDmg[plr] = { t = now, h = hp, d = dmg }; lastHit[plr] = now
    if Settings.Misc.hitLogs then showLog(plr.DisplayName, char:FindFirstChild("HeadHitbox") and "Head" or rp.Name, string.format("%.0f", dmg), string.format("%.0f", hp), hp <= 0) end
end

local function trackPlayer(plr)
    if plr == lp then return end
    local function onChar(char)
        task.spawn(function()
            local hum = char:WaitForChild("Humanoid", 10); if not hum then return end
            hum.Died:Connect(function() local now = os.clock(); if deathSeen[plr] and now - deathSeen[plr] <= 1.5 then return end; deathSeen[plr] = now; lastHit[plr] = nil end)
            local hp = hum.Health
            hum.HealthChanged:Connect(function(n) local p = hp; hp = n; if n < p - 0.05 then onDamaged(plr, char, p - n, n) end end)
        end)
    end
    if plr.Character then onChar(plr.Character) end; plr.CharacterAdded:Connect(onChar)
end
