    local prev = lastLog[name]
    if prev and ((hpV <= 0 and prev.h <= 0 and now - prev.t <= 2) or (now - prev.t <= 0.35 and math.abs(prev.h - hpV) <= 0.001)) then return end
    lastLog[name] = { t = now, h = hpV }
    
