local shots = {}
local function isOurs(pos)
    local now = os.clock()
    for i = #shots, 1, -1 do
        local s = shots[i]
        if now - s.t > 6 then table.remove(shots, i) else
            local v = pos - s.o; local a = v:Dot(s.d)
            if a > 0 and (v - s.d * a).Magnitude <= math.clamp(2.25 + a * 0.002, 2.25, 8) then return true end
        end
    end
end

