local DRAG_SPEED = 22
local function makeDraggable(handle, target, onStart)
	local dragging, startMouse, startX, startY, goalX, goalY = false
	handle.InputBegan:Connect(function(i)
		if isPress(i) then
			if onStart then onStart() end
			dragging = true; startMouse = i.Position; startX, startY = target.Position.X.Offset, target.Position.Y.Offset; goalX, goalY = startX, startY
			i.Changed:Connect(function() if i.UserInputState == Enum.UserInputState.End then dragging = false end end)
		end
	end)
	UIS.InputChanged:Connect(function(i) if dragging and isMove(i) then local d = i.Position - startMouse; goalX, goalY = startX + d.X, startY + d.Y end end)
	RunService.RenderStepped:Connect(function(dt)
		if not goalX then return end
		local p = target.Position; local a = 1 - math.exp(-DRAG_SPEED * dt)
		local nx = p.X.Offset + (goalX - p.X.Offset) * a; local ny = p.Y.Offset + (goalY - p.Y.Offset) * a
		if not dragging and math.abs(goalX - nx) < 0.3 and math.abs(goalY - ny) < 0.3 then nx, ny = goalX, goalY; goalX, goalY = nil, nil end
		target.Position = UDim2.new(p.X.Scale, nx, p.Y.Scale, ny)
	end)
end

